# Индекс-фикстура H1-5 хранит sha256 своих файлов (manifest.json), поэтому байты
# обязаны совпадать на Windows и Linux: иначе после checkout контракт падает не
# из-за правки, а из-за CRLF. `eol=lf` держит LF и в рабочей копии Windows.
fixtures/** text eol=lf
# H2-3: shebang в start.sh ломается, если Git выдаст CRLF (Git Bash/WSL).
start.sh text eol=lf
