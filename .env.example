# .env.example — скопируйте в .env и заполните

# LLM (LM Studio)
LLM_NAME=gemma-4-e4b
# id модели в API, если он отличается от имени каталога индекса.
# Пример: индекс собран под каталог gemma-4-e4b, а LM Studio принимает
# только google/gemma-4-e4b (иначе 400 Invalid model identifier).
# LLM_API_NAME=google/gemma-4-e4b
LLM_BASE_URL=http://localhost:1234/v1

# Индекс
SAVE_DIR=outputs/astrology_test

# Веб-сервер (H2-3, one-command start: start.bat / start.sh)
APP_HOST=127.0.0.1
APP_PORT=8000
# Проверка LM Studio при старте: 1 — проверять, 0 — пропустить.
STARTUP_CHECK_LM=1
# Таймаут проверки LM Studio в секундах.
STARTUP_CHECK_TIMEOUT=5

# Embedding (опционально — переопределяет значение по умолчанию)
# EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# API-сервер (search_api)
# API_KEY=ваш-секретный-ключ      ← все запросы требуют заголовок X-API-Key
# MAX_UPLOAD_MB=200               ← лимит размера загружаемых PDF
# API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Обратная связь Web UI (append-only JSONL, без персональных данных)
# FEEDBACK_PATH=outputs/feedback/feedback.jsonl

# Требование ключа (по умолчанию включено):
# API_KEY_REQUIRED=1  → без API_KEY сервер НЕ СТАРТУЕТ (fail-closed).
#                        Это режим по умолчанию, потому что репозиторий публичный,
#                        а API отдаёт содержимое локального корпуса.
# API_KEY_REQUIRED=0  → ключ не требуется (fail-open). Только для локальной
#                        разработки на loopback, никогда для выставленного наружу API.
# Если сервер запускается без API_KEY при API_KEY_REQUIRED=1, процесс падает
# сразу на старте с понятной ошибкой, а не молча открывается.
#
# Как выставить наружу: задайте API_KEY, оставьте API_KEY_REQUIRED=1 и запускайте
# на 127.0.0.1, публикуя порт через SSH-туннель или reverse-proxy с TLS.

# Docker (H2-3, docker compose up --build)
# В контейнере localhost — это сам контейнер, поэтому LM Studio на хосте
# доступна по host.docker.internal. docker-compose.yml задаёт этот адрес сам;
# переопределить можно переменной LLM_BASE_URL_DOCKER (только для compose):
# LLM_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
#
# Внутри контейнера SAVE_DIR должен указывать на смонтированный каталог:
# относительный путь разрешается от /app, например outputs/astrology_test
# превращается в /app/outputs/astrology_test. Абсолютный /app/outputs/... тоже
# подходит.
#
# Права на bind-mount (Linux): контейнер работает под UID/GID 10001.
# Чтобы писать в outputs/, cache/ и temp_uploads/ от своего пользователя,
# выполните в shell перед запуском:
#   export DOCKER_UID=$(id -u)
#   export DOCKER_GID=$(id -g)
# или заранее: sudo chown -R $(id -u):$(id -g) outputs cache temp_uploads
#
# API_KEY_REQUIRED=0 в docker-compose.yml допустим только потому, что порт
# опубликован на 127.0.0.1. Для доступа снаружи задайте API_KEY и
# API_KEY_REQUIRED=1 (или reverse-proxy с TLS).
